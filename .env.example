# ===== LLM / Embedding / Rerank（OpenAI 兼容格式）=====
# 你的 API 密钥，填在下面引号里
LLM_API_KEY=

# 三个服务的 Base URL（如果同一个网关统一提供，三者可以相同）
# 示例：阿里云百炼 https://dashscope.aliyuncs.com/compatible-mode/v1
#       火山方舟  https://ark.cn-beijing.volces.com/api/v3
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RERANKER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名称
EMBEDDING_MODEL=text-embedding-flash
LLM_MODEL=qwen3.7-plus
RERANKER_MODEL=bge-reranker-v2-m3

# 向量维度（必须与 embedding 模型输出维度一致，换模型时同步修改并重建向量库）
EMBEDDING_DIM=1024

# ===== 向量数据库（Qdrant）=====
# 二选一：
#   方式一（服务模式）：QDRANT_URL 指向运行中的 Qdrant 服务，QDRANT_PATH 留空
#   方式二（本地模式）：设置 QDRANT_PATH 为本地目录，无需启动 Qdrant 服务（开发推荐）
QDRANT_URL=http://localhost:6333
QDRANT_PATH=./data/qdrant
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks

# ===== 业务数据库（PostgreSQL，存完整 chunk 数据 + 文档元数据）=====
PG_HOST=localhost
PG_PORT=5432
PG_DB=rag
PG_USER=postgres
PG_PASSWORD=

# ===== RAG 检索参数 =====
RETRIEVAL_TOP_K=10
RERANK_TOP_N=3

# ===== JWT 鉴权 =====
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
